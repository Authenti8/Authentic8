# -----------------------------------------------------------------------------
# Authenti8 local application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
API_PORT=4000
# Comma-separated trusted proxy IPs/CIDRs or proxy-addr names.
# Keep the API private to these proxies in production. Local Next.js uses loopback.
TRUSTED_PROXIES=loopback

# -----------------------------------------------------------------------------
# Supabase Postgres — required now
# DATABASE_URL must authenticate as the non-owner authenti8_backend role.
# Owner credentials belong only in .env.migration, never in this runtime file.
# Run migrations, assign authenti8_backend a strong password in the SQL editor,
# then use that role through the Session Pooler for persistent API traffic.
# Keep sslmode=require and URL-encode special characters in the password.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://authenti8_backend.PROJECT_REF:URL_ENCODED_APP_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_POOL_MAX=5
# Local Docker runtime: postgresql://authenti8_backend:APP_PASSWORD@localhost:5432/authenti8

# -----------------------------------------------------------------------------
# Google OAuth — required to enable "Continue with Google"
# Create a Google OAuth 2.0 Web application and register the callback exactly.
# Calendar scopes are intentionally not requested in Phases 1–5.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# -----------------------------------------------------------------------------
# Email — optional locally, required before production
# Without SMTP, development returns verification/reset preview links in the UI.
# Common SMTP providers use port 587 with SMTP_SECURE=false.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Authenti8 <no-reply@authenti8.com>"
# Generate with: openssl rand -base64 32
AUTH_MAIL_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Supabase Storage — reserved for later evidence/file-storage phases
# These are not read by the Phase 1–5 application and are not needed to start.
# Never expose SUPABASE_SERVICE_ROLE_KEY to browser code.
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
