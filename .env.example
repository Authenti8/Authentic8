# -----------------------------------------------------------------------------
# Authenti8 local application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# Production feature origins. Keep these equal to APP_ORIGIN for local development.
AUTH_ORIGIN=http://localhost:3000
ONBOARDING_ORIGIN=http://localhost:3000
DASHBOARD_ORIGIN=http://localhost:3000
PAYMENT_ORIGIN=http://localhost:3000
# Production only: shares the login session across the feature subdomains.
SESSION_COOKIE_DOMAIN=
# Production values:
# APP_ORIGIN=https://authenti8.com
# AUTH_ORIGIN=https://auth.authenti8.com
# ONBOARDING_ORIGIN=https://onboarding.authenti8.com
# DASHBOARD_ORIGIN=https://dashboard.authenti8.com
# PAYMENT_ORIGIN=https://payment.authenti8.com
# SESSION_COOKIE_DOMAIN=.authenti8.com
NEXT_PUBLIC_WINDOWS_AGENT_INSTALLER_URL=https://downloads.example.com/Authenti8VerifySetup.exe
# Local development only. Production serves the API from APP_ORIGIN/api.
API_ORIGIN=http://localhost:4000
API_PORT=4000
# Comma-separated trusted proxy IPs/CIDRs or proxy-addr names.
# Keep the API private to these proxies in production. Local Next.js uses loopback.
TRUSTED_PROXIES=loopback

# -----------------------------------------------------------------------------
# Supabase Data API — required
# The API calls server-only PostgreSQL functions through Supabase REST. It does
# not open PostgreSQL connections, so no Database URL or pooler is required.
# Prefer the modern sb_secret_ key. Legacy projects may use the service_role
# JWT in SUPABASE_SERVICE_ROLE_KEY instead. Never expose either to browser code.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://nlrbcvbhjoswsyqsshum.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Google identity handoff requires one public key. Prefer the modern publishable
# key; SUPABASE_ANON_KEY remains supported for projects using the legacy anon JWT.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Google OAuth — required to enable "Continue with Google"
# Create a Google OAuth 2.0 Web application and register the callback exactly.
# Login and Calendar authorization are separate flows and callbacks.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CALENDAR_CALLBACK_URL=http://localhost:3000/api/v1/integrations/google/callback
# Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Dodo Payments — test mode for Professional and extra interview checkout
# Create one recurring $1,000/month product and one one-time $5 product.
# -----------------------------------------------------------------------------
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PROFESSIONAL_PRODUCT_ID=
DODO_EXTRA_INTERVIEW_PRODUCT_ID=

# -----------------------------------------------------------------------------
# Email — optional locally, required before production
# Without SMTP, development returns verification/reset preview links in the UI.
# Common SMTP providers use port 587 with SMTP_SECURE=false.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Authenti8 <no-reply@authenti8.com>"
# Generate with: openssl rand -base64 32
AUTH_MAIL_ENCRYPTION_KEY=
# Shared with Supabase Cron for mail, Calendar maintenance, and billing webhooks.
# Generate with: openssl rand -base64 32
CRON_SECRET=
# Production Chrome Web Store extension ID used for recruiter token provisioning.
RECRUITER_EXTENSION_ID=
# Signed Chrome detection pack used by the candidate extension before the first managed pack exists.
CHROME_RULE_PACK_JSON=
