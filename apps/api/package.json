{
  "name": "@authenti8/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./serverless": {
      "types": "./dist/serverless.d.ts",
      "default": "./dist/serverless.js"
    }
  },
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "npm run build -w @authenti8/contracts && npm run build -w @authenti8/event-schemas && npm run build -w @authenti8/security && npm run build -w @authenti8/validation",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "pretest": "node -e \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\"",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-dist/**/*.test.js"
  },
  "dependencies": {
    "@authenti8/contracts": "0.1.0",
    "@authenti8/event-schemas": "0.1.0",
    "@authenti8/security": "0.1.0",
    "@authenti8/validation": "0.1.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "nodemailer": "^9.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2"
  }
}
